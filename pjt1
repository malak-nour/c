/* =====================================================================
   STRING CLEANING & HELPERS
   ===================================================================== */

// Cleans a string: removes punctuation, converts to lowercase, collapses spaces (to avoid any comlexity in comparisons).
void superClean(char* s) {
    if (!s) return;
    int i = 0, j = 0;
    while (s[i]) {
        if (isalnum((unsigned char)s[i])) {
            s[j++] = tolower((unsigned char)s[i]);
        } else if (isspace((unsigned char)s[i])) {
            if (j > 0 && s[j-1] != ' ') s[j++] = ' ';
        }
        i++;
    }
    s[j] = '\0';
    if (j > 0 && s[j-1] == ' ') s[j-1] = '\0';
}

// Checks if a line is empty (only whitespace) , to help identify paragraph breaks.
int is_line_empty(const char *s) {
    if (!s) return 1;
    while (*s) {
        if (!isspace((unsigned char)*s)) return 0;
        s++;
    }
    return 1;
}

