// Recursive helper to traverse the tree and write to file
void SaveInorder(ptrN R, FILE* f) {
    if (!R) return;
    SaveInorder(LC_Ai(R), f);
    char* info = Info_Ai(R);
    if (info) fprintf(f, "%s\n", info);
    SaveInorder(RC_Ai(R), f);
}

// Function that saves and stores the result
void SaveTreeToFile(ptrN R, const char* filename) {
    FILE* f = fopen(filename, "w");
    if (!f) { 
        printf("Error saving result.\n"); 
        return; 
    }
    if (R) {
        SaveInorder(R, f);
    }
    fclose(f);
    printf("\n[STATUS] THE RESULT IS SAVED IN %s (even if empty or filled)\n", filename);
}

