/*******************************UNION's procedures********************************/

// Helper to insert all elements of a tree into another (used for union)
void InsertAll(ptrN s, ptrN* d) {
    if (!s) return;
    InsertAll(LC_Ai(s), d);
    // Ensure Info_Ai returns a valid string
    char* info = Info_Ai(s);
    if (info) {
        *d = InsertBST_Ai(*d, DupStr(info));
    }
    InsertAll(RC_Ai(s), d);
}

//Combines all unique elements from both trees
ptrN UnionBST(ptrN a, ptrN b) {
    ptrN r = NULL;
    InsertAll(a, &r);
    InsertAll(b, &r);
    return r;
}

/*******************************INTERSECTION's procedures********************************/   
                                                                             
// INTERSECTION: Finds common elements between two trees
void InterAll(ptrN a, ptrN b, ptrN* r) {
    if (!a) return;
    InterAll(LC_Ai(a), b, r);
    char* info = Info_Ai(a);
    if (info && SearchBST_Ai(b, info))
        *r = InsertBST_Ai(*r, DupStr(info));
    InterAll(RC_Ai(a), b, r);
}

// Returns a new tree containing only elements present in both a and b
ptrN IntersectionBST(ptrN a, ptrN b) {
    ptrN r = NULL;
    InterAll(a, b, &r);
    return r;
}

/*******************************DIFFERENCE's procedures********************************/  

// DIFFERENCE: Finds elements in a that are NOT in b
void DiffAll(ptrN a, ptrN b, ptrN* r) {
    if (!a) return;
    DiffAll(LC_Ai(a), b, r);
    char* info = Info_Ai(a);
    if (info && !SearchBST_Ai(b, info))
        *r = InsertBST_Ai(*r, DupStr(info));
    DiffAll(RC_Ai(a), b, r);
}

// Returns a new tree containing elements in a that are not in b
ptrN DifferenceBST(ptrN a, ptrN b) {
    ptrN r = NULL;
    DiffAll(a, b, &r);
    return r;
}

/* =====================================================================
   SPECIAL ONE-FILE LOGIC
   ===================================================================== */

// INTERSECTION: Finds duplicates across ALL paragraphs
void FindDuplicatesInFile(const char* filename, ptrN* resultTree, int level) {
    ptrN seenOnce = NULL;
    FILE* f = fopen(filename, "r");
    if (!f) { printf("Error opening file.\n"); return; }

    char line[4096];
    if (level == 1) { // Paragraph Duplicates
        char paraBuffer[15000] = ""; int inPara = 0;
        while (fgets(line, sizeof(line), f)) {
            if (is_line_empty(line)) {
                if (inPara) {
                    superClean(paraBuffer);
                    if (strlen(paraBuffer) > 0) {
                        if (SearchBST_Ai(seenOnce, paraBuffer)) 
                            *resultTree = InsertBST_Ai(*resultTree, DupStr(paraBuffer));
                        else 
                            seenOnce = InsertBST_Ai(seenOnce, DupStr(paraBuffer));
                    }
                    paraBuffer[0] = '\0'; inPara = 0;
                }
            } else { 
                inPara = 1; 
                if (strlen(paraBuffer) + strlen(line) < sizeof(paraBuffer) - 1) strcat(paraBuffer, line);
            }
        }
        if (inPara) { // Final check for end of file without empty line
            superClean(paraBuffer);
            if (strlen(paraBuffer) > 0) {
                if (SearchBST_Ai(seenOnce, paraBuffer)) *resultTree = InsertBST_Ai(*resultTree, DupStr(paraBuffer));
                else seenOnce = InsertBST_Ai(seenOnce, DupStr(paraBuffer));
            }
        }
    } else { // Sentence Duplicates
        while (fgets(line, sizeof(line), f)) {
            char* s = strtok(line, ".!?\n");
            while (s) {
                char* c = strdup(s);
                superClean(c);
                if (strlen(c) > 0) {
                    if (SearchBST_Ai(seenOnce, c)) 
                        *resultTree = InsertBST_Ai(*resultTree, DupStr(c));
                    else 
                        seenOnce = InsertBST_Ai(seenOnce, DupStr(c));
                }
                free(c); s = strtok(NULL, ".!?\n");
            }
        }
    }
    fclose(f);
    FreeTree_Ai(seenOnce);
}

// DIFFERENCE: User chooses 2 specific paragraphs to compare if the file contained more than 2 paragraphs .
void LoadDifferenceSelection(const char* filename, ptrN* treeA, ptrN* treeB, int level) {
    FILE* f = fopen(filename, "r");
    if (!f) return;

    char line[4096];
    int totalParas = 0, inPara = 0;
    while (fgets(line, sizeof(line), f)) {
        if (is_line_empty(line)) inPara = 0;
        else if (!inPara) { totalParas++; inPara = 1; }
    }
    rewind(f);

    if (totalParas < 2) {
        printf("\n[ERROR] Found only %d paragraph(s). Need at least two for Difference.\n", totalParas);
        fclose(f); return;
    }

    int choiceA, choiceB;
    printf("\n[INFO] Found %d paragraphs. Pick exactly two.\n", totalParas);
    printf("Select First Para (Set A): "); scanf("%d", &choiceA);
    printf("Select Second Para (Set B): "); scanf("%d", &choiceB);

    int currentIdx = 0; inPara = 0;
    char paraBuffer[15000] = "";
    while (fgets(line, sizeof(line), f)) {
        if (is_line_empty(line)) {
            if (inPara) {
                if (currentIdx == choiceA || currentIdx == choiceB) {
                    ptrN* target = (currentIdx == choiceA) ? treeA : treeB;
                    if (level == 1) { 
                        superClean(paraBuffer); 
                        if (strlen(paraBuffer) > 0) *target = InsertBST_Ai(*target, DupStr(paraBuffer)); 
                    } else {
                        char* s = strtok(paraBuffer, ".!?\n");
                        while (s) {
                            char* c = strdup(s); superClean(c);
                            if (strlen(c) > 0) *target = InsertBST_Ai(*target, c); else free(c);
                            s = strtok(NULL, ".!?\n");
                        }
                    }
                }
                paraBuffer[0] = '\0'; inPara = 0;
            }
        } else { 
            if (!inPara) { currentIdx++; inPara = 1; } 
            if (strlen(paraBuffer) + strlen(line) < sizeof(paraBuffer) - 1) strcat(paraBuffer, line); 
        }
    }
    // Case where file ends on a paragraph without a following blank line
    if (inPara && (currentIdx == choiceA || currentIdx == choiceB)) {
        ptrN* target = (currentIdx == choiceA) ? treeA : treeB;
        if (level == 1) {
            superClean(paraBuffer);
            if (strlen(paraBuffer) > 0) *target = InsertBST_Ai(*target, DupStr(paraBuffer));
        } else {
            char* s = strtok(paraBuffer, ".!?\n");
            while (s) {
                char* c = strdup(s); superClean(c);
                if (strlen(c) > 0) *target = InsertBST_Ai(*target, c); else free(c);
                s = strtok(NULL, ".!?\n");
            }
        }
    }
    fclose(f);
}

/* =====================================================================
   STANDARD LOADING
   ===================================================================== */

// Loads file content into a BST based on the chosen level (paragraph or sentence)
void LoadFileToBST(const char* filename, ptrN* root, int level) {
    FILE* f = fopen(filename, "r");
    if (!f) { printf("Error: Could not open %s\n", filename); return; }
    char line[4096];
    if (level == 1) {
        char paraBuffer[15000] = ""; int inPara = 0;
        while (fgets(line, sizeof(line), f)) {
            if (is_line_empty(line)) {
                if (inPara) { 
                    superClean(paraBuffer); 
                    if (strlen(paraBuffer) > 0) *root = InsertBST_Ai(*root, DupStr(paraBuffer)); 
                    paraBuffer[0] = '\0'; inPara = 0; 
                }
            } else { 
                inPara = 1; 
                if (strlen(paraBuffer) + strlen(line) < sizeof(paraBuffer) - 1) strcat(paraBuffer, line); 
            }
        }
        if (inPara) { superClean(paraBuffer); if (strlen(paraBuffer) > 0) *root = InsertBST_Ai(*root, DupStr(paraBuffer)); }
    } else {
        while (fgets(line, sizeof(line), f)) {
            char* s = strtok(line, ".!?\n");
            while (s) {
                char* c = strdup(s); 
                superClean(c); // Fix: Ensure tree1 & tree2 sentences match by cleaning during load
                if (strlen(c) > 0) *root = InsertBST_Ai(*root, c); else free(c);
                s = strtok(NULL, ".!?\n");
            }
        }
    }
    fclose(f);
}

